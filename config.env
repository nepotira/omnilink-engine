# ==============================================================================
# POCO Zero-Latency Game Engine - Configuration Overrides
# This file is automatically loaded by poco-gaming.sh if present.
# ==============================================================================

# Suppress Snap launcher popup notice dialogs
export SNAP_LAUNCHER_NOTICE_ENABLED="false"

# Performance Profile: "max" (1080p 3:2 @ 16M) or "eco" (720p 3:2 @ 8M - Low Heat)
PERF_PROFILE="max"

# Video Streaming Settings
# VIDEO_CODEC: "h265" (HEVC - Recommended) or "h264" or "av1"
VIDEO_CODEC="h265"

# Bitrate: Recommended 12M to 24M for USB 2.0 / USB 3.0 (eco profile defaults to 8M)
VIDEO_BITRATE="16M"

# Display Buffering: 0 means instantaneous rendering (ultra-low latency)
VIDEO_BUFFER=0

# Connection Tunnel: 1 forces direct ADB forward for maximum stability
FORCE_ADB_FORWARD=1

# Audio Settings
# AUDIO_BUFFER: Audio buffer in milliseconds (50ms prevents PipeWire starvation)
AUDIO_BUFFER=50

# AUDIO_SOURCE: "playback" (captures game audio cleanly on HyperOS/Android 14+)
AUDIO_SOURCE="playback"

# AUDIO_DUP: 1 plays audio on both PC and POCO speakers simultaneously
AUDIO_DUP=1

# Audio Codec: "opus" or "aac" (empty for default)
AUDIO_CODEC="opus"

# Target Refresh Rate: 60, 90, or 120 (0 = auto-detect from device/host)
# TARGET_FPS=60

# Screen Orientation Controls
# Force POCO rotation: "270" (Landscape), "0" (Portrait), "90", "180" (leave empty to not force)
REQUESTED_ROTATION=""

# Laptop Screen Auto-Rotation Lock (Zorin OS / GNOME Wayland)
# 1 automatically locks laptop orientation while gaming to prevent 2-in-1 sensor rotation
LOCK_LAPTOP_ROTATION=0

# Custom Resolution Override (leave empty for automatic host screen detection)
# CUSTOM_HOST_W=1920
# CUSTOM_HOST_H=1280

# Custom Density (DPI) Override (leave empty for automatic proportional calculation)
# TARGET_DENSITY=280

# Input Controls: Enable direct Linux kernel USB HID emulation
ENABLE_UHID_KEYBOARD=1
ENABLE_UHID_MOUSE=1
ENABLE_UHID_GAMEPAD=1

# Thermal & Battery Protection
# Turn off physical phone screen during gaming session
TURN_SCREEN_OFF=1
# Prevent phone from going to sleep during gameplay
STAY_AWAKE=1
